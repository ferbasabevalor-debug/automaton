# ─────────────────────────────────────────────────────────────────────
# Plantilla de variables de entorno de Automaton.
# NO pongas valores reales aquí: este archivo se sube a GitHub.
# En Railway se ponen en: tu servicio → pestaña "Variables".
# Guía completa en español: RAILWAY.md
# ─────────────────────────────────────────────────────────────────────

# ── OBLIGATORIAS ─────────────────────────────────────────────────────

# La "misión" del agente: qué debe hacer para ganar dinero (texto libre).
AUTOMATON_GENESIS_PROMPT=

# TU dirección de wallet (la del dueño). EVM: empieza por 0x y tiene 42 caracteres.
AUTOMATON_CREATOR_ADDRESS=

# ── RECOMENDADAS ─────────────────────────────────────────────────────

# Nombre del agente (por defecto: automaton).
AUTOMATON_NAME=

# Tope de gasto diario en dólares (por defecto: 2). Ej.: 1, 2.5, 10
MAX_DAILY_SPEND_USD=2

# ── OPCIONALES ───────────────────────────────────────────────────────

# Clave de Conway. Si la dejas vacía, el agente la consigue solo con su wallet.
CONWAY_API_KEY=

# Claves propias de IA (si no se ponen, usa la IA de Conway pagando con créditos).
OPENAI_API_KEY=
ANTHROPIC_API_KEY=

# Modelo de IA a usar (por defecto: gpt-5.2).
AUTOMATON_INFERENCE_MODEL=

# Red de la wallet del agente: evm (Base, por defecto) o solana.
AUTOMATON_CHAIN=evm

# AVANZADO: importar una clave privada existente en lugar de crear una nueva.
# Solo se usa la primera vez (si aún no hay wallet guardada). Mejor dejarla vacía.
WALLET_PRIVATE_KEY=

# AVANZADO: servidores alternativos.
CONWAY_API_URL=
AUTOMATON_RPC_URL=
SOLANA_RPC_URL=
OLLAMA_BASE_URL=
